# Machine-specific settings for theia_frontend.
# Copy to .env.local (ignored by git) and uncomment only what differs on your machine.
#
# Nothing is needed when theia_frontend sits inside the workspace next to robot_app,
# vision_app and ee_app, as on the Jetson dev machine (/home/ev3d/Workcell_Stack-ws) and
# in production (/home/theia/Workcell_Stack-ws): the workspace is found as the parent folder.
# The resolved paths are listed at http://127.0.0.1:50300/api/workcell-paths

# --- Workspace: the folder that holds the modules -----------------------------------------
# WORKCELL_ROOT=/home/theia/Workcell_Stack-ws

# --- One module checked out elsewhere or under another name (e.g. Windows clones) ----------
# ROBOT_APP_DIR=X:/dev/FT-Theia/FT_Workcell_Robotics
# VISION_APP_DIR=X:/dev/FT-Theia/FT_Workcell_Vision
# EE_APP_DIR=X:/dev/FT-Theia/FT_Workcell_End_Effector

# --- One single folder or file (wins over everything above) -------------------------------
# BEHAVIOR_TREE_DIR=       # <robot_app>/aldm_control/config/BehaviorTree
# ROBOT_PARAMS_DIR=        # <robot_app>/aldm_control/config/phases
# VISION_PARAMS_DIR=       # <vision_app>/ev3d_vision/config
# EE_VISION_PARAMS_FILE=   # <VISION_PARAMS_DIR>/vision_params.yaml
# EE_TARGET_MODELS_DIR=    # <vision_app>/ev3d_vision/pointclouds
# EE_ROUTINES_DIR=         # <ee_app>/config/routines/aldm
# END_EFFECTORS_DIR=       # <ee_app>/config/end_effectors

# --- Services (defaults shown) -------------------------------------------------------------
# ROSBRIDGE_URL=ws://127.0.0.1:9090
# VIDEO_SERVER_URL=http://127.0.0.1:8081
# EE_TEST_GATEWAY_URL=http://127.0.0.1:8765
# VISION_PYTHON=python3
